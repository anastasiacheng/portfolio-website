# Imported by /etc/caddy/Caddyfile. /admin goes to the backend; everything else is static.
anastasiacheng.com, www.anastasiacheng.com {
	encode gzip

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy 127.0.0.1:8091
	}

	handle {
		root * /var/www/mywebsite
		# Browsers must re-check the page and resume on every visit (unchanged files get a
		# quick 304), so a publish or resume upload shows up without a hard refresh.
		@revalidate path / /index.html *.pdf
		header @revalidate Cache-Control "no-cache"
		file_server {
			hide .git .gitignore
		}
	}
}
